# ─── Flask ────────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_long_random_string
JWT_SECRET_KEY=change_this_to_another_long_random_string

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# These are the credentials used to SEND emails from the system.
# The system sends emails ON BEHALF of your agency using this account.
#
# For Gmail (recommended):
#   1. Go to: https://myaccount.google.com/security
#   2. Enable "2-Step Verification" (required for App Passwords)
#   3. Go to: https://myaccount.google.com/apppasswords
#   4. Create a new App Password → select "Mail" + "Windows Computer"
#   5. Copy the 16-character password (no spaces) and paste it below
#
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=velouracreations@gmail.com
MAIL_PASSWORD=your_16_char_app_password_here
MAIL_DEFAULT_SENDER=Veloura Creations <velouracreations@gmail.com>
